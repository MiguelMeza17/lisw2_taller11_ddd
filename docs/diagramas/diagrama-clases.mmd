classDiagram
    class Pregunta {
        <<AggregateRoot>>
        -Long id
        -EstadoPregunta estado
        +agregarOpcion(String, boolean)
        +quitarOpciones()
        +enviarARevision()
        +iniciarRevision()
        +aprobar()
        +rechazar()
        +publicar()
        +archivar()
        -validarInvariantesParaEnvio()
    }
    class Enunciado {
        <<ValueObject>>
        -String texto
    }
    class Justificacion {
        <<ValueObject>>
        -String texto
        +LONGITUD_MINIMA = 15
    }
    class OpcionRespuesta {
        <<ValueObject>>
        -String texto
        -boolean esCorrecta
    }
    class EstadoPregunta {
        <<enumeration>>
        BORRADOR
        PENDIENTE_REVISION
        EN_REVISION
        APROBADA
        PUBLICADA
        ARCHIVADA
        +puedeTransitarA(EstadoPregunta) boolean
    }
    class Revisor {
        <<Entity>>
        -Long idDocente
        -String nombre
    }
    class Revision {
        <<Entity>>
        -Long id
        -Long idPregunta
        -Dictamen dictamen
        -String observaciones
        +aprobar(String)
        +rechazar(String)
        +aplicarDictamenA(Pregunta)
    }
    class Dictamen {
        <<enumeration>>
        PENDIENTE
        APROBADA
        RECHAZADA
    }
    class PreguntaRepository {
        <<interface>>
        +guardar(Pregunta) Pregunta
        +buscarPorId(Long) Optional~Pregunta~
        +listar() List~Pregunta~
        +buscarPorEstado(EstadoPregunta) List~Pregunta~
    }
    class ReglaNegocioException
    class DomainException

    Pregunta *-- "1" Enunciado
    Pregunta *-- "1" Justificacion
    Pregunta *-- "0..4" OpcionRespuesta
    Pregunta --> EstadoPregunta
    Revision --> "1" Revisor
    Revision --> Dictamen
    Revision ..> Pregunta : idPregunta
    PreguntaRepository ..> Pregunta : persiste
    DomainException <|-- ReglaNegocioException
    Pregunta ..> ReglaNegocioException : lanza
